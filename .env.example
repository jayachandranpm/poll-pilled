# Optional. In platform mode, provider credentials are configured in admin-only settings.
MODEL_API_KEY=
# Meta Wit.ai uses a separate server access token for speech synthesis.
WIT_AI_TOKEN=
# Optional dedicated Fernet vault key from your secret manager. When absent, a
# random 0600 key file is created beside the SQLite database. Back it up separately.
AI_VAULT_KEY=
# Set a long random value in a deployed environment.
SECRET_KEY=
PORT=5055

# Cloudflare Access: configure both to enforce verified account identity.
# The domain must be https://YOUR-TEAM.cloudflareaccess.com (no trailing path).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Turnstile: configure all three for protected flows; routine actions use session protection.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=

# Catalyst / platform deployment (configure privately, never commit real values).
ADMIN_EMAIL=
PUBLIC_APP_URL=
# Leave platform/auth/storage flags off for local development.
PLATFORM_MODE=false
PP_CATALYST_AUTH_ENABLED=false
PP_CATALYST_STORAGE=false
PP_CATALYST_BUCKET=
PP_CATALYST_CACHE_SEGMENT=
PP_EMAIL_AUTH_FALLBACK_ENABLED=true
PAYMENTS_MODE=test
